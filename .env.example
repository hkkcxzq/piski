# Скопируйте в .env (он в .gitignore) и заполните. Никогда не коммитьте ключи.
# Ключ Bybit: создаётся в режиме Demo Trading, права только Orders + Positions, БЕЗ вывода средств.
QUANT_BYBIT_API_KEY=
QUANT_BYBIT_API_SECRET=
QUANT_TELEGRAM_BOT_TOKEN=
# QUANT_MODE=demo
# QUANT_CONFIG=config/local.yaml
# Новостной монитор: ключ Anthropic API (или выполните `ant auth login`)
ANTHROPIC_API_KEY=
# Telegram: id чата для уведомлений (узнать: написать боту и открыть https://api.telegram.org/bot<TOKEN>/getUpdates)
QUANT_TELEGRAM_CHAT_ID=
